pipeline {
    agent any

    parameters {
        string(name: 'DOCKER_REGISTRY', defaultValue: 'registry.example.com', description: 'Docker registry host')
        string(name: 'DOCKER_IMAGE', defaultValue: 'ops-agent', description: 'Repository name')
    }

    environment {
        DOCKER_TAG   = "${BUILD_NUMBER}"
        K8S_NAMESPACE = 'default'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Current branch: ${env.BRANCH_NAME}"
            }
        }

        stage('Test') {
            steps {
                sh 'pip install -r app/requirements.txt'
                sh 'python -m pytest app/tests/ -v --junitxml=reports/junit.xml'
                sh 'python -m pytest examples/demo-app/tests/ -v --junitxml=reports/demo-junit.xml'
            }
            post {
                always {
                    junit 'reports/*.xml'
                }
            }
        }

        stage('Build & Push') {
            steps {
                sh """
                    docker build \
                        -t ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:latest \
                        -f docker/Dockerfile .
                """
                withCredentials([usernamePassword(
                    credentialsId: 'docker-registry-credentials',
                    usernameVariable: 'REGISTRY_USER',
                    passwordVariable: 'REGISTRY_PASSWORD'
                )]) {
                    sh """
                        echo "\${REGISTRY_PASSWORD}" | docker login \
                            ${params.DOCKER_REGISTRY} \
                            --username "\${REGISTRY_USER}" --password-stdin
                        docker push ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        stage('Deploy to K8s') {
            steps {
                sh """
                    kubectl delete job ops-agent-db-migrate \
                        -n ${K8S_NAMESPACE} --ignore-not-found
                    sed 's#image: ops-agent:v1#image: ${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:${DOCKER_TAG}#' \
                        k8s/migration-job.yaml | kubectl apply -n ${K8S_NAMESPACE} -f -
                    kubectl wait --for=condition=complete \
                        job/ops-agent-db-migrate -n ${K8S_NAMESPACE} --timeout=180s
                """
                sh """
                    kubectl set image deployment/ops-agent \
                        ops-agent=${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:${DOCKER_TAG} \
                        -n ${K8S_NAMESPACE}
                    kubectl set image deployment/ops-agent-worker \
                        worker=${params.DOCKER_REGISTRY}/${params.DOCKER_IMAGE}:${DOCKER_TAG} \
                        -n ${K8S_NAMESPACE}
                """
                sh "kubectl rollout status deployment/ops-agent -n ${K8S_NAMESPACE} --timeout=120s"
                sh "kubectl rollout status deployment/ops-agent-worker -n ${K8S_NAMESPACE} --timeout=120s"
            }
        }
    }

    post {
        success {
            echo 'Pipeline 执行成功！'
        }
        failure {
            echo 'Pipeline 执行失败，请检查日志。'
        }
        always {
            cleanWs()
        }
    }
}
